# Draws the dashboard on the touchscreen framebuffer. Installed by
# deploy/install.sh.
[Unit]
Description=pi-homelab-dashboard touchscreen UI
After=homelab-daemon.service unbind-fbcon.service
Wants=homelab-daemon.service unbind-fbcon.service

[Service]
Type=simple
User=pi-homelab
Group=pi-homelab
# video for /dev/fb1, input for the touch device
SupplementaryGroups=video input
Environment=SOCKET_PATH=/run/pi-homelab-dashboard/daemon.sock
# the install directory is read-only for this user, so do not try to write .pyc files
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/pi-homelab-dashboard/current/dashboard
ExecStart=/usr/bin/python3 /opt/pi-homelab-dashboard/current/dashboard/dashboard.py
# on-failure, not always: a tap-to-exit (clean exit 0) should stay exited,
# only a crash (nonzero exit) should auto-restart.
Restart=on-failure
RestartSec=2

# minimal sandbox (security-specialist, T-010): must be confirmed on the real Pi before
# release. No PrivateDevices: the dashboard needs /dev/fb1 and /dev/input.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
