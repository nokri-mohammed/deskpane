# Receives UDP reports from every device and serves the latest status to the
# dashboard over a Unix socket. Installed by deploy/install.sh.
[Unit]
Description=deskpane report daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deskpane
Group=deskpane
# LISTEN_ADDR (and the reporter's DEVICE_ID, LABEL) live here; upgrades never overwrite it
EnvironmentFile=-/etc/deskpane/env
# the socket lives in /run/deskpane (created by systemd), readable by this user only
RuntimeDirectory=deskpane
RuntimeDirectoryMode=0750
UMask=0077
Environment=SOCKET_PATH=/run/deskpane/daemon.sock
ExecStart=/opt/deskpane/current/bin/deskpane-daemon
Restart=always
RestartSec=2

# sandbox (security-specialist, T-010): must be confirmed on the real Pi before release
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
