# Reports the Pi's own stats to the daemon on the same Pi. Installed by
# deploy/install.sh.
[Unit]
Description=deskpane reporter (reports the Pi's own stats)
After=network-online.target deskpane-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=deskpane
Group=deskpane
# may read pisugar-server's socket (/run/pisugar, group pisugar) for --battery
# pisugar (T-064); install.sh creates the group when it is missing
SupplementaryGroups=pisugar
# DEVICE_ID and LABEL come from here; empty means automatic id and hostname label.
# BATTERY (none or pisugar) and PISUGAR_SOCKET reach the process as environment
# variables; the reporter reads BATTERY itself, so it is not on the command line
# and an older binary (no --battery) still starts after a rollback
EnvironmentFile=/etc/deskpane/env
# ${VAR} (with braces) stays one argument, so a label with spaces works, and empty
# stays ""
ExecStart=/opt/deskpane/current/bin/deskpane report --daemon 127.0.0.1:8765 --device-id ${DEVICE_ID} --label ${LABEL} --interval 2
Restart=always
RestartSec=2

# sandbox (security-specialist, T-010): must be confirmed on the real Pi before release
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
