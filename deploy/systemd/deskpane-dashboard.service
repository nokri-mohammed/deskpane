# Draws the dashboard on the touchscreen framebuffer. Installed by
# deploy/install.sh.
[Unit]
Description=deskpane touchscreen UI
After=deskpane-daemon.service deskpane-unbind-fbcon.service
Wants=deskpane-daemon.service deskpane-unbind-fbcon.service

[Service]
Type=simple
User=deskpane
Group=deskpane
# video for /dev/fb1, input for the touch device
SupplementaryGroups=video input
Environment=SOCKET_PATH=/run/deskpane/daemon.sock
# optional character pack (install.sh --characters), root owned, read only here
Environment=CHARACTERS_DIR=/var/lib/deskpane/characters
# the install directory is read-only for this user, so do not try to write .pyc files
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/deskpane/current/dashboard
ExecStart=/usr/bin/python3 /opt/deskpane/current/dashboard/dashboard.py
# on-failure, not always: a tap-to-exit (clean exit 0) should stay exited,
# only a crash (nonzero exit) should auto-restart.
Restart=on-failure
RestartSec=2

# minimal sandbox (security-specialist, T-010): must be confirmed on the real Pi before
# release. No PrivateDevices: the dashboard needs /dev/fb1 and /dev/input.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
