# Display overlay for the Elegoo 3.5" SPI touchscreen (ILI9486 + XPT2046), from
# goodtft/LCD-show. That repo has no license, so we never ship the file: the
# installer downloads it from this pinned commit and checks this SHA-256.
# Plain KEY=value lines; install.sh and provision-pi.sh read them, never source them.
OVERLAY_URL=https://raw.githubusercontent.com/goodtft/LCD-show/8cb161e14073db9073bb1076cf86d61b8b55ed30/usr/tft35a-overlay.dtb
OVERLAY_SHA256=601ea7056da5d7864648798fd3656b4205f01d6b9a6a8a5cfad6ca5601bbbe1e
