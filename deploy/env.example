# deskpane settings, read by the systemd units.
# install.sh copies this to /etc/deskpane/env on the first install
# and never overwrites it. Restart the services after editing:
#   sudo systemctl restart deskpane-daemon deskpane-reporter

# device id and label the Pi's own reporter uses on the dashboard. Empty means
# automatic: an id derived from /etc/machine-id (e.g. dp-3f9a0c41) and the
# hostname as the label. Ids: 1 to 64 letters, digits, dot, dash or underscore.
DEVICE_ID=
LABEL=

# where the daemon listens for reports from other machines
LISTEN_ADDR=0.0.0.0:8765
