# pi-homelab-dashboard settings, read by the systemd units.
# install.sh copies this to /etc/pi-homelab-dashboard/env on the first install
# and never overwrites it. Restart the services after editing:
#   sudo systemctl restart homelab-daemon homelab-reporter

# device id and label the Pi's own reporter uses on the dashboard
DEVICE_ID=pi-zero
LABEL=Raspberry Pi

# where the daemon listens for reports from other machines
LISTEN_ADDR=0.0.0.0:8765
