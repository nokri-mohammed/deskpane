# deskpane settings, read by the systemd units.
# install.sh copies this to /etc/deskpane/env on the first install
# and never overwrites it. Restart the services after editing:
#   sudo systemctl restart deskpane-daemon deskpane-reporter

# device id and label the Pi's own reporter uses on the dashboard. Empty means
# automatic: an id derived from /etc/machine-id (e.g. dp-3f9a0c41) and the
# hostname as the label. Ids: 1 to 64 letters, digits, dot, dash or underscore.
DEVICE_ID=
LABEL=

# battery on the screen (T-064): none, or pisugar to read a PiSugar board
# through pisugar-server's Unix socket. Set it up first as docs/INSTALL.md
# ("PiSugar battery") says; the socket path below is that setup's default.
BATTERY=none
#PISUGAR_SOCKET=/run/pisugar/pisugar-server.sock

# where the daemon listens for reports from other machines
LISTEN_ADDR=0.0.0.0:8765

# plugins turned on, comma separated, e.g. PANELS=weather,ups. Each one gets a
# page on the screen after the device pages (docs/PANELS.md), and the daemon
# only accepts numbers (metric packets) from the plugins listed here, so nobody
# on the network can take a plugin's name or fill the table with others.
# Empty: no plugin is turned on. Restart deskpane-daemon and
# deskpane-dashboard after a change.
PANELS=
