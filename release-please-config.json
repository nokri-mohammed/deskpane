{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "versioning": "prerelease",
  "prerelease-type": "beta",
  "prerelease": true,
  "draft": true,
  "force-tag-creation": true,
  "packages": {
    ".": {
      "package-name": "deskpane",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0-beta.1",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='daemon')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='reporter')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='deskpane-contract')].version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='deskpane-sdk')].version"
        },
        {
          "type": "toml",
          "path": "plugins/example-report/source/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='deskpane-contract')].version"
        },
        {
          "type": "toml",
          "path": "plugins/example-report/source/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='deskpane-sdk')].version"
        },
        {
          "type": "generic",
          "path": "docs/INSTALL.md"
        }
      ]
    }
  }
}
